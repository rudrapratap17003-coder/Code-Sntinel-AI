# CodeSentinel AI — Backend Environment Configuration Template
# Copy this file to .env and adjust values for your local environment.

# Server & Environment Mode (development | production | test)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (comma-separated additional origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Workspace Analysis Security
# Set to false to disable local directory scanning (recommended for public deployments)
ALLOW_LOCAL_ANALYSIS=true

# Semicolon-separated allowed workspace directories for local scanning (leave empty for project root)
ALLOWED_LOCAL_WORKSPACES=

# Resource Caps & Timeouts
MAX_FILES=500
MAX_REPO_SIZE_MB=50
MAX_FILE_SIZE_BYTES=1000000
MAX_EXTRACTED_SIZE_MB=150
MAX_EXTRACTED_FILES=2500
MAX_DIRECTORY_DEPTH=25
DOWNLOAD_TIMEOUT_SECONDS=20
ANALYSIS_TIMEOUT_SECONDS=60

# Optional GitHub Personal Access Token (increases rate limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=

# Optional Google Gemini AI Explanation Layer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
